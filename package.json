{
  "name": "stash-roulette",
  "version": "0.9.1",
  "description": "Browse a local media folder with previews and attach a picked or random file on X and Discord.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "build:dev": "node scripts/build.mjs --dev",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build:demo": "node scripts/build.mjs --demo"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "author": "Stash Roulette contributors",
  "homepage": "https://github.com/real-gooner/stash-roulette",
  "bugs": {
    "url": "https://github.com/real-gooner/stash-roulette/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/real-gooner/stash-roulette.git"
  }
}
